{
  "buildCommand": "cd ../packages/shared && npm run build && cd ../../backend && npm run build",
  "installCommand": "npm install --prefix .. && npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" }
  ]
}
