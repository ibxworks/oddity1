SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
ODDITY_GOOGLE_OAUTH_CLIENT_ID=

### OpenRouter (LLM) API keys — get one at openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP1=
OPENROUTER_API_KEY_BACKUP2=
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
OPENROUTER_REASONING_MODEL=
OPENROUTER_ROUTER_MODEL=
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_ATTEMPTS_PER_KEY=2
OPENROUTER_RETRY_BASE_DELAY_MS=250
OPENROUTER_RETRY_MAX_DELAY_MS=2000

### BYOK (Bring Your Own Key)
# 32 bytes as 64 hex chars. Generate: openssl rand -hex 32. Required to save
# user provider keys; without it the llm-keys endpoints return 503.
BYOK_ENCRYPTION_KEY=
# Free model backing the "Oddity Free" provider option (server OpenRouter key).
ODDITY_FREE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Free Convert API Key
FREECONVERT_API_KEY=

### Stripe and Plans
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

DASHBOARD_URL=https://app.example.com

STRIPE_STANDARD_PRODUCT_ID=prod_YOUR_PRODUCT_ID

STRIPE_STANDARD_PAYMENT_LINK_YEARLY=https://buy.stripe.com/YOUR_YEARLY_LINK
STRIPE_STANDARD_PAYMENT_LINK_QUARTERLY=https://buy.stripe.com/YOUR_QUARTERLY_LINK
STRIPE_STANDARD_PAYMENT_LINK_MONTHLY=https://buy.stripe.com/YOUR_MONTHLY_LINK

STRIPE_STANDARD_PRICEID_YEARLY=price_YOUR_YEARLY_PRICE_ID
STRIPE_STANDARD_PRICEID_QUARTERLY=price_YOUR_QUARTERLY_PRICE_ID
STRIPE_STANDARD_PRICEID_MONTHLY=price_YOUR_MONTHLY_PRICE_ID

FREE_PLAN_LIMIT_PER_MONTH=100
STANDARD_PLAN_LIMIT_PER_MONTH=2000
