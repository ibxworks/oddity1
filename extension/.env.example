# Copy to extension/.env and fill in your own values. Never commit real keys.
# These are read at build time via import.meta.env (Vite).

# Supabase project (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PostHog analytics (optional — analytics is disabled when unset)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Backend URL used by the extension (local dev default)
ODDITY_BACKEND_URL=http://localhost:3001

# Chrome Extension OAuth client ID (Google Cloud Console → Credentials).
# Required at build time by manifest.config.ts.
ODDITY_GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
